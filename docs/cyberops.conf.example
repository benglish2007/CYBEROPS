# CYBEROPS configuration example
# Copy to ${XDG_CONFIG_HOME:-$HOME/.config}/cyberops/config.
# Environment variables override values in this file.

STACK_ROOT=/srv/stacks
RETRY_DELAY=5
HEALTH_TIMEOUT=120
HEALTH_INTERVAL=5
FAILURE_LOG_LINES=80
DRY_RUN=0
CYBEROPS_THEME=neon-overdrive
CYBEROPS_NO_COLOR=0
CYBEROPS_LOGGING=1
CYBEROPS_HEADER_TELEMETRY=1
CYBEROPS_HEADER_TIME=1
CYBEROPS_HEADER_LINK=1
CYBEROPS_HEADER_VPN=1
CYBEROPS_HEADER_IFACE=1
CYBEROPS_HEADER_LOCAL_IP=1
CYBEROPS_HEADER_MAC=1
# Public-IP lookup contacts api.ipify.org. It is disabled by default.
CYBEROPS_HEADER_PUBLIC_IP=0
CYBEROPS_HEADER_TIMEOUT=2
CYBEROPS_PUBLIC_IP_CACHE_TTL=300
